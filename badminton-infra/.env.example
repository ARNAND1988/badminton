CLOUDFLARED_TOKEN=replace-with-your-cloudflare-tunnel-token
WHATSAPP_BOT_TOKEN=replace-with-a-long-random-internal-token
WHATSAPP_ACCESS_TOKEN=replace-with-meta-system-user-token
WHATSAPP_PHONE_NUMBER_ID=replace-with-meta-phone-number-id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=replace-with-a-long-random-verification-token
WHATSAPP_APP_SECRET=replace-with-meta-app-secret
WHATSAPP_GRAPH_API_VERSION=v23.0
# Use E.164 format (for example +31612345678). Without a real number the
# seeded super-admin can log in but cannot receive password-reset codes.
ANAND_SUPER_ADMIN_PHONE=+31612345678
ANAND_SUPER_ADMIN_PASSWORD=replace-with-a-strong-unique-password
